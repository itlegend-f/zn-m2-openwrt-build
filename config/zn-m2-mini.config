CONFIG_TARGET_ipq60xx=y
CONFIG_TARGET_ipq60xx_generic=y
CONFIG_TARGET_ipq60xx_generic_DEVICE_zn_m2=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
#禁用USB
CONFIG_DEFAULT_kmod-usb-phy-msm=n
CONFIG_DEFAULT_kmod-usb3=n
CONFIG_USB_SUPPORT=n
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb-dwc3=n
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=n
CONFIG_PACKAGE_kmod-usb-phy-msm=n
CONFIG_PACKAGE_kmod-usb3=n
#调整内核
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y
#安装NWAM3所需文件
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_kmod-ipt-conntrack-extra=y
CONFIG_PACKAGE_kmod-ipt-ipopt=y
##
#########################################################
##
#软件
CONFIG_PACKAGE_luci-app-ramfree=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-arpbind=y
#CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
